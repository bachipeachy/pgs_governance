{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pgs_governance.schemas.SCHEMA_MOLECULE_V0",
  "title": "OmniBachi Molecule Schema V0",
  "description": "JSON Schema for canonical molecule artifacts (compiler input). Governed by CONSTITUTION_COMPILER_V0.",
  "type": "object",
  "required": ["ct_code", "inputs", "steps", "outputs", "emit"],
  "additionalProperties": false,
  "properties": {
    "ct_code": {
      "type": "string",
      "pattern": "^CT_[A-Z0-9_]+_V[0-9]+(_MOLECULE)?$",
      "description": "Unique molecule identifier"
    },
    "inputs": {
      "type": "object",
      "description": "Named input parameters with types",
      "additionalProperties": {
        "oneOf": [
          { "type": "string" },
          { "$ref": "#/$defs/typedField" }
        ]
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "description": "Ordered composition steps",
      "items": { "$ref": "#/$defs/step" }
    },
    "outputs": {
      "type": "object",
      "minProperties": 1,
      "description": "Output declarations",
      "additionalProperties": { "$ref": "#/$defs/typedField" }
    },
    "emit": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "description": "Single output emission mapping (output_name -> step_symbol)",
      "additionalProperties": { "type": "string" }
    }
  },
  "$defs": {
    "typedField": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["string", "number", "boolean", "object", "array", "any"]
        },
        "description": { "type": "string" }
      }
    },
    "step": {
      "type": "object",
      "required": ["kind", "as"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["atom", "molecule", "loop"],
          "description": "Step kind: atom (primitive), molecule (composite), or loop"
        },
        "as": {
          "type": "string",
          "description": "Symbol name for step output"
        },
        "atom": {
          "type": "string",
          "pattern": "^[A-Z_][A-Z0-9_]*$",
          "description": "Atom instruction name (atoms only)"
        },
        "molecule": {
          "type": "string",
          "pattern": "^CT_[A-Z0-9_]+_V[0-9]+(_MOLECULE)?$",
          "description": "Molecule CT code to invoke (molecules only)"
        },
        "with": {
          "type": "object",
          "description": "Input bindings ($.inputs.x or $.results.step.field)",
          "additionalProperties": { "type": "string" }
        },
        "over": {
          "type": "string",
          "description": "Collection path to iterate (loops only)"
        },
        "iterator": {
          "type": "string",
          "description": "Iterator variable name (loops only)"
        },
        "accumulator": {
          "type": "object",
          "description": "Initial accumulator bindings (loops only)",
          "additionalProperties": { "type": "string" }
        },
        "inputs": {
          "type": "object",
          "description": "Loop body inputs (loops only)",
          "additionalProperties": { "type": "string" }
        },
        "update_accumulator": {
          "type": "object",
          "description": "Accumulator update bindings (loops only)",
          "additionalProperties": { "type": "string" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "atom" } } },
          "then": { "required": ["atom", "with"] }
        },
        {
          "if": { "properties": { "kind": { "const": "molecule" } } },
          "then": { "required": ["molecule", "with"] }
        },
        {
          "if": { "properties": { "kind": { "const": "loop" } } },
          "then": { "required": ["molecule", "over", "iterator", "accumulator"] }
        }
      ]
    }
  }
}
