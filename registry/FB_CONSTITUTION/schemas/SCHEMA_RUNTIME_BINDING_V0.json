{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pgs_governance.schemas.SCHEMA_RUNTIME_BINDING_V0",
  "title": "OmniBachi Runtime Binding Schema V0",
  "description": "JSON Schema for materialized runtime binding artifacts. Structural validation only — semantic binding correctness governed by ASSERT_RB_* handlers.",
  "type": "object",
  "required": ["rb_code", "version", "governed_by", "core"],
  "additionalProperties": false,
  "properties": {
    "rb_code": {
      "type": "string",
      "pattern": "^RB_[A-Z0-9_]+_V[0-9]+$",
      "description": "Unique runtime binding identifier"
    },
    "version": {
      "type": "string",
      "pattern": "^[Vv][0-9]+$",
      "description": "Version string"
    },
    "governed_by": {
      "type": "string",
      "description": "Governing constitution FQDN"
    },
    "parameters": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Required runtime parameters (resolved from env_facts)"
    },
    "core": {
      "type": "object",
      "required": ["summary", "bindings"],
      "additionalProperties": true,
      "properties": {
        "summary": {
          "type": "string",
          "description": "Human-readable summary"
        },
        "description": {
          "type": "string",
          "description": "Detailed description"
        },
        "storage_structure": {
          "type": "string",
          "description": "FQDN of the storage structure artifact governing this binding's storage layout"
        },
        "bindings": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/runtimeBinding"
          },
          "description": "Map of CS FQDN to runtime configuration"
        }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "runtimeBinding": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "host": {
          "type": "string",
          "description": "Host identifier for the bound side effect"
        },
        "operation": {
          "type": "string",
          "description": "Operation mode identifier"
        },
        "type": {
          "type": "string",
          "description": "Binding type classifier"
        },
        "policy": {
          "type": "object",
          "additionalProperties": true,
          "description": "Policy configuration (storage path, strict mode, etc.)"
        },
        "config": {
          "type": "object",
          "additionalProperties": true,
          "description": "Configuration object (alternative to policy in some binding styles)"
        }
      }
    }
  }
}
